<?xml version="1.0"?>
<!-- P37 reference geometry, authored for the Steel browser research demo.
     Procedural reference embodiment: NOT a Panda/Sawyer/IIWA/UR5e model. -->
<robot name="p37-reference-extended">
  <material name="titanium"><color rgba="0.51 0.57 0.60 1"/></material>
  <material name="obsidian"><color rgba="0.105 0.135 0.16 1"/></material>
  <material name="signal"><color rgba="0.70 0.94 0.80 1"/></material>
  <link name="base">
    <inertial><origin xyz="0 0 0.06"/><mass value="4.0"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.030"/></inertial>
    <visual><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.105" length="0.12"/></geometry><material name="obsidian"/></visual>
    <collision><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.105" length="0.12"/></geometry></collision>
  </link>
  <link name="shoulder_link">
    <inertial><origin xyz="0 0 0.15"/><mass value="2.1"/><inertia ixx="0.023" ixy="0" ixz="0" iyy="0.023" iyz="0" izz="0.012"/></inertial>
    <visual><origin xyz="0 0 0.145"/><geometry><cylinder radius="0.071" length="0.29"/></geometry><material name="titanium"/></visual>
    <collision><origin xyz="0 0 0.145"/><geometry><cylinder radius="0.071" length="0.29"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="110" velocity="2.0"/><dynamics damping="0.38"/>
  </joint>
  <link name="upper_link">
    <inertial><origin xyz="0.2600 0 0"/><mass value="1.5"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.036" iyz="0" izz="0.036"/></inertial>
    <visual><origin xyz="0.2600 0 0" rpy="0 1.5707963268 0"/><geometry><cylinder radius="0.052" length="0.52"/></geometry><material name="obsidian"/></visual>
    <collision><origin xyz="0.2600 0 0" rpy="0 1.5707963268 0"/><geometry><cylinder radius="0.052" length="0.52"/></geometry></collision>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="shoulder_link"/><child link="upper_link"/>
    <origin xyz="0 0 0.29" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.3" upper="2.3" effort="85" velocity="2.0"/><dynamics damping="0.26"/>
  </joint>
  <link name="forearm">
    <inertial><origin xyz="0.1950 0 0"/><mass value="0.9"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.014" iyz="0" izz="0.014"/></inertial>
    <visual><origin xyz="0.1950 0 0" rpy="0 1.5707963268 0"/><geometry><cylinder radius="0.037" length="0.39"/></geometry><material name="titanium"/></visual>
    <collision><origin xyz="0.1950 0 0" rpy="0 1.5707963268 0"/><geometry><cylinder radius="0.037" length="0.39"/></geometry></collision>
  </link>
  <joint name="wrist" type="revolute">
    <parent link="upper_link"/><child link="forearm"/>
    <origin xyz="0.52 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="45" velocity="3.0"/><dynamics damping="0.18"/>
  </joint>
  <link name="tool">
    <inertial><origin xyz="0.025 0 0"/><mass value="0.35"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    <visual><origin xyz="0.025 0 0"/><geometry><box size="0.07 0.09 0.06"/></geometry><material name="signal"/></visual>
    <collision><origin xyz="0.025 0 0"/><geometry><box size="0.07 0.09 0.06"/></geometry></collision>
  </link>
  <joint name="tool_mount" type="fixed"><parent link="forearm"/><child link="tool"/><origin xyz="0.39 0 0"/></joint>
</robot>
