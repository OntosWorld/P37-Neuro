<mujoco model="p37_reference_tabletop_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <geom density="500" rgba="0.25 0.45 0.8 1"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="1 1 0.02" rgba="0.85 0.85 0.85 1"/>
    <body name="base" pos="0 0 0.08">
      <geom type="cylinder" size="0.07 0.08"/>
      <body name="link_1">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.0 2.0" damping="0.5" armature="0.02"/>
        <geom type="capsule" size="0.025" fromto="0 0 0 0.22 0 0"/>
        <body name="link_2" pos="0.22 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-2.0 2.0" damping="0.5" armature="0.02"/>
          <geom type="capsule" size="0.02" fromto="0 0 0 0.18 0 0"/>
          <body name="end_effector" pos="0.18 0 0">
            <geom type="sphere" size="0.03" rgba="0.9 0.3 0.2 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_position" joint="shoulder" kp="80" ctrlrange="-2.0 2.0" ctrllimited="true"/>
    <position name="elbow_position" joint="elbow" kp="60" ctrlrange="-2.0 2.0" ctrllimited="true"/>
  </actuator>
</mujoco>
